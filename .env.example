# VK community token. On Bothost, the Bot Token field is usually available as BOT_TOKEN.
# Set VK_TOKEN only if BOT_TOKEN is not provided by the host.
VK_TOKEN=put_vk_community_token_here
# Optional fallback; the bot tries to detect the community ID from the token.
VK_GROUP_ID=

# AI API (OpenAI-compatible chat/completions endpoint)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=put_ai_api_key_here
AI_MODEL=put_model_name_here

TEACHER_VK_ID=2840329
